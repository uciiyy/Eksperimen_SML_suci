name: titanic_mlproject

entry_points:
  main:
    parameters:
      n_estimators:
        type: int
        default: 100
      max_depth:
        type: int
        default: 5
      min_samples_split:
        type: int
        default: 2
      test_size:
        type: float
        default: 0.2
    command: "python modelling.py --n_estimators {n_estimators} --max_depth {max_depth} --min_samples_split {min_samples_split} --test_size {test_size}"